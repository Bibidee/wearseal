    {"step": 7, "route": "/inspect", "actor": "owner", "action": "Claim owner allocation", "approval": true, "expect": "owner_claimed = true"},
    {"step": 8, "route": "/inspect", "actor": "renter", "action": "Claim renter allocation", "approval": true, "expect": "renter_claimed = true and both claims finalized"}
